{
  "apiVersion": "batch-postprocess-v2",
  "version": "6.0.0",
  "entrypoint": "builtin",
  "dependence": [
    "data-analysis"
  ],
  "configSchema": {
    "type": "object",
    "additionalProperties": false
  },
  "id": "browser-gallery",
  "name": "浏览器渲染画廊",
  "description": "采集截图与渲染证据，并生成可筛选的离线 HTML 画廊。",
  "outputs": [
    {
      "key": "web-quality-evidence",
      "scope": "sample",
      "title": "Web 质量检测证据",
      "dataType": "json",
      "required": false
    },
    {
      "key": "browser-capture",
      "scope": "sample",
      "title": "Web 渲染截图",
      "dataType": "image",
      "renderer": "gallery",
      "required": true
    },
    {
      "key": "capture-summary",
      "scope": "dataset",
      "title": "截图汇总",
      "dataType": "metrics",
      "required": true,
      "renderer": "kpi"
    },
    {
      "key": "browser-gallery",
      "scope": "dataset",
      "title": "浏览器渲染画廊",
      "dataType": "link",
      "required": true,
      "renderer": "link"
    }
  ],
  "presentation": {
    "defaultView": "gallery",
    "sampleFields": [
      {
        "key": "captureStatus",
        "label": "截图状态",
        "type": "string",
        "filterable": true,
        "sortable": true
      }
    ]
  }
}
